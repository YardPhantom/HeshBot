# Only chat.php is reachable; knowledge, prompt, config example and storage are private.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <Files "chat.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "chat.php">
    Allow from all
  </Files>
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Cache-Control "no-store"
</IfModule>
